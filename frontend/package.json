{
  "name": "bingo-flashboard-ui",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "gen:game-types": "node ../scripts/generate-game-types.mjs",
    "dev": "npm run gen:game-types && vite",
    "dev:shared-mock": "npm run gen:game-types && VITE_SHARED_MOCK=true node ./dev/shared-mock-server.mjs & VITE_SHARED_MOCK=true vite --host",
    "build": "npm run gen:game-types && tsc -b && node ../scripts/build-caller-voice-packs.mjs && node ../scripts/prune-spiffs-data.mjs && vite build && node ../scripts/prune-spiffs-data.mjs",
    "build:voice-packs": "node ../scripts/build-caller-voice-packs.mjs",
    "preview": "vite preview",
    "check:game-types": "node ../scripts/generate-game-types.mjs --check && node ../scripts/validate-game-types.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-label": "^2.1.1",
    "@radix-ui/react-radio-group": "^1.2.2",
    "@radix-ui/react-select": "^2.1.4",
    "@radix-ui/react-slider": "^1.2.2",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-tabs": "^1.1.2",
    "barcode-detector": "^3.2.1",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "tailwind-merge": "^2.6.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "~5.6.0",
    "vite": "^6.0.0"
  }
}
